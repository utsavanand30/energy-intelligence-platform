# ── Copy this file to .env for local development ──────────────────────────

# Local PostgreSQL (brew / docker-compose)
DATABASE_URL=postgresql://energy_user:energy_pass@localhost:5432/energy_db

# Neon.tech (free cloud PostgreSQL — no credit card)
# Get this from: console.neon.tech → your project → Connection Details
# DATABASE_URL=postgresql://neondb_owner:<password>@<ep-xxx>.neon.tech/neondb?sslmode=require

# Auth
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Simulation
SIMULATION_MODE=realtime
SCAN_INTERVAL_SECONDS=30

# CORS — set to your deployed URL in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "true" inside Docker when serving the built React app
SERVE_FRONTEND=false
