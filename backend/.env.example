# ── Copy this file to .env for local development ──────────────────────────

# Local PostgreSQL (brew / docker-compose)
DATABASE_URL=postgresql://energy_user:energy_pass@localhost:5432/energy_db

# Neon.tech (free cloud PostgreSQL — no credit card)
# Get this from: console.neon.tech → your project → Connection Details
# DATABASE_URL=postgresql://neondb_owner:<password>@<ep-xxx>.neon.tech/neondb?sslmode=require

# Auth (legacy — kept for backward compatibility; prefer JWT_* below)
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# Generate a strong secret with:
#   JWT_SECRET_KEY=<run: python -c "import secrets; print(secrets.token_hex(32))">
JWT_SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SMTP (optional) ────────────────────────────────────────────────────────
# When SMTP_HOST is empty the app starts fine — email features degrade
# gracefully (verification links are logged to stdout instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=EnergyIQ Platform

# ── Microsoft Azure AD SSO (optional) ─────────────────────────────────────
# Required only when you want /api/auth/sso/microsoft login to work.
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations
# Set the redirect URI to: <FRONTEND_URL>/api/auth/sso/microsoft/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ── Google Workspace SSO (optional) ───────────────────────────────────────
# Required only when you want /api/auth/sso/google login to work.
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Set the redirect URI to: <FRONTEND_URL>/api/auth/sso/google/callback
# Leave GOOGLE_WORKSPACE_DOMAIN blank to allow any Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=

# ── App ────────────────────────────────────────────────────────────────────
# Frontend base URL — used in email links and OAuth redirect URIs.
FRONTEND_URL=http://localhost:5173

# Simulation
SIMULATION_MODE=realtime
SCAN_INTERVAL_SECONDS=30

# CORS — set to your deployed URL in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "true" inside Docker when serving the built React app
SERVE_FRONTEND=false
